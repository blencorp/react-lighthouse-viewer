{
  "name": "react-lighthouse-viewer-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @blen/react-lighthouse-viewer build",
    "dev": "pnpm --filter example dev",
    "lint": "oxlint --type-aware --deny-warnings && oxfmt --check",
    "format": "oxfmt && oxlint --fix",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @blen/react-lighthouse-viewer test",
    "check": "pnpm build && pnpm lint && pnpm typecheck && pnpm test && pnpm --filter @blen/react-lighthouse-viewer check:package && pnpm --filter example build",
    "reports": "node scripts/generate-sample-reports.ts"
  },
  "devDependencies": {
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "playwright": "1.64.1"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.11.2"
}
