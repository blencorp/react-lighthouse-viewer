{
  "name": "react-lighthouse-viewer-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @blen/react-lighthouse-viewer build",
    "dev": "pnpm --filter example dev",
    "lint": "oxlint --type-aware --deny-warnings && oxfmt --check",
    "format": "oxfmt && oxlint --fix",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @blen/react-lighthouse-viewer test",
    "check": "pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm --filter @blen/react-lighthouse-viewer check:package && pnpm --filter example build"
  },
  "devDependencies": {
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.11.2"
}
